# Base RPC endpoint — the public one works (no paid RPC needed)
RPC_URL=https://mainnet.base.org

# Wallet shown across the dashboard: trade markers, My Wallet tab, profile.
# Read-only. Leave blank to use the dashboard without a wallet.
WALLET_ADDRESS=

# Required ONLY for trading and limit orders. Stays on your machine.
# Leave blank for read-only mode. Use a burner wallet — not your main one.
PRIVATE_KEY=
